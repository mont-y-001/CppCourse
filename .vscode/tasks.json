{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build, Run, and Clean",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "g++ ${file} -o ${fileDirname}\\${fileBasenameNoExtension}.exe && ${fileDirname}\\${fileBasenameNoExtension}.exe && del ${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}